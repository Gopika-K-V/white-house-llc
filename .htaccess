<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # 1. Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # 2. Force non-www (Redirect www.whitehomesmaterials.com to whitehomesmaterials.com)
    RewriteCond %{HTTP_HOST} ^www\.whitehomesmaterials\.com [NC]
    RewriteRule ^(.*)$ https://whitehomesmaterials.com/$1 [L,R=301]
    
    # 3. Remove .html extension from URLs (so /terms.html can just be /terms)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# 4. Enable Browser Caching for static assets (images, css, js)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/html "access plus 1 day"
</IfModule>

# 5. Disable Directory Browsing (Security best practice)
Options -Indexes
